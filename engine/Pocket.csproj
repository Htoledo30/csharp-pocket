<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O motor do C# Pocket: compila e executa o código do usuário dentro do navegador.
    Este projeto gera só o Pocket.dll. O runtime do .NET e o Roslyn em WebAssembly
    ficam prontos em src/framework (a versão do Roslyn abaixo tem que ser a mesma de lá).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pocket</AssemblyName>
    <RootNamespace>Pocket</RootNamespace>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>false</UseAppHost>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

</Project>
